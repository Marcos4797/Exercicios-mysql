-- Q18
SELECT 
    al.nome 			AS 'Nome_Aluno',
    au.nome				AS 'Nome_Aula',
    inst.nome			AS 'Nome_instrutor'
FROM inscricoes i
JOIN alunos al ON i.aluno_id = al.id
JOIN aulas au ON i.aula_id = au.id
JOIN instrutores inst ON au.instrutor_id = inst.id
WHERE i.status = 'ativa'
ORDER BY al.nome;

