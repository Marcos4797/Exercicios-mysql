-- 	Q19
SELECT p.nome, COUNT(a.id)
FROM planos p
JOIN alunos a ON a.plano_id = p.id
GROUP BY p.nome
ORDER BY COUNT(a.id) DESC;

-- Q20
SELECT especialidade, ROUND(AVG(salario),2)  AS Media
FROM instrutores
GROUP BY especialidade
ORDER BY Media DESC;

-- Q21
SELECT a.nome, COUNT(i.id)  AS inscricao_total
FROM aulas a
JOIN inscricoes i ON i.aula_id = a.id
WHERE i.status = 'Ativa'
GROUP BY a.nome
HAVING COUNT(i.id) > 2
ORDER BY inscricao_total DESC;

